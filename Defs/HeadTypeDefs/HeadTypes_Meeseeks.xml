<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- HAR's old "aliencrowntypes" system was replaced by vanilla HeadTypeDefs.
       HAR builds the final texture path as <graphicPaths><head><path> + Gender_Name,
       so a head named "Male_<X>" resolves to Things/Pawn/Meeseeks/Head/Male_<X>. -->

  <HeadTypeDef>
    <defName>CM_Meeseeks_Box_Head_Male_Happy</defName>
    <graphicPath>Things/Pawn/Meeseeks/Head/Male_Happy</graphicPath>
